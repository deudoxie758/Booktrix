datasource db {
    provider = "mysql"
    url      = env("DATABASE_URL")
}

generator client {
    provider = "prisma-client-js"
}

enum Role {
    USER
    OWNER
    EMPLOYEE
    ACCOUNTANT
    ADMIN
}

enum BusinessRole {
    OWNER
    MANAGER
    ACCOUNTS
    STAFF
}

enum BusinessStatus {
    APPLICATION
    UNDER_REVIEW
    APPROVED
    SETUP
    PUBLISHED
    REJECTED
    SUSPENDED
    ARCHIVED
}

enum ApplicationStatus {
    DRAFT
    SUBMITTED
    UNDER_REVIEW
    APPROVED
    REJECTED
}

enum BookingStatus {
    PENDING
    CONFIRMED
    CANCELLED
    NO_SHOW
    COMPLETED
}

enum PaymentMethod {
    CARD
    CASH
}

enum PaymentStatus {
    UNPAID
    PARTIAL
    PAID
    REFUNDED
}

enum ConfirmationMode {
    AUTOMATIC
    MANUAL
}

enum PaymentChoice {
    FULL
    DEPOSIT
    CASH
}

enum PaymentRequestStatus {
    PENDING
    PAID
    FAILED
    REFUNDED
}

enum DepositKind {
    FIXED
    PERCENTAGE
}

enum BookingOrderStatus {
    DRAFT
    HELD
    PAYMENT_PENDING
    REQUESTED
    CONFIRMED
    COMPLETED
    PARTIALLY_CANCELLED
    CANCELLED
    EXPIRED
}

enum BookingSegmentStatus {
    REQUESTED
    CONFIRMED
    IN_PROGRESS
    COMPLETED
    REJECTED
    CANCELLED
    NO_SHOW
}

enum BookingOrigin {
    CUSTOMER
    MANAGER
    WALK_IN
    LEGACY
}

model User {
    id             String    @id @default(cuid())
    email          String    @unique
    hashedPassword String?
    name           String?
    image          String?
    points         Int       @default(0)
    role           Role      @default(USER)
    OwnedSpas      Spa[]
    Employee       Employee?
    Bookings       Booking[] @relation("UserBookings")
    Reviews        Review[]
    Notifications  Notification[]
    SupportTickets SupportTicket[]
    BusinessMemberships BusinessMembership[]
    SubmittedBusinessApplications BusinessApplication[] @relation("BusinessApplicant")
    ReviewedBusinessApplications BusinessApplication[] @relation("BusinessReviewer")
    BookingOrders BookingOrder[]
    BookingHolds BookingHold[]
    InvitedBusinessInvitations BusinessInvitation[] @relation("BusinessInvitationInviter")
    createdAt      DateTime  @default(now())
    updatedAt      DateTime  @updatedAt
}

model Business {
    id              String               @id @default(cuid())
    name            String
    slug            String               @unique
    status          BusinessStatus       @default(APPLICATION)
    defaultCurrency String               @default("XCD")
    coverImageUrl   String?
    legacySpaId     String?              @unique
    Memberships     BusinessMembership[]
    Locations       Location[]
    Applications    BusinessApplication[]
    Setup           BusinessSetup?
    ServiceOfferings ServiceOffering[]
    BookingHolds BookingHold[]
    BookingOrders BookingOrder[]
    SchedulingLocks SchedulingLock[]
    Invitations BusinessInvitation[]
    createdAt       DateTime             @default(now())
    updatedAt       DateTime             @updatedAt
}

model Location {
    id          String               @id @default(cuid())
    businessId  String
    business    Business             @relation(fields: [businessId], references: [id])
    name        String
    slug        String
    timezone    String               @default("America/St_Lucia")
    address     String?
    phone       String?
    email       String?
    businessHours Json?
    isActive    Boolean              @default(true)
    Assignments LocationAssignment[]
    ServiceLocations ServiceLocation[]
    StaffQualifications StaffQualification[]
    Hours LocationHours[]
    StaffSchedules StaffSchedule[]
    StaffTimeOff StaffTimeOff[]
    HoldSegments BookingHoldSegment[]
    BookingSegments BookingSegment[]
    SchedulingLocks SchedulingLock[]
    InvitationLocations BusinessInvitationLocation[]
    InvitationQualifications BusinessInvitationQualification[]
    createdAt   DateTime             @default(now())
    updatedAt   DateTime             @updatedAt

    @@unique([businessId, slug])
    @@index([businessId, isActive])
}

model BusinessMembership {
    id         String               @id @default(cuid())
    businessId String
    userId     String
    role       BusinessRole
    active     Boolean              @default(true)
    business   Business             @relation(fields: [businessId], references: [id])
    user       User                 @relation(fields: [userId], references: [id])
    Locations  LocationAssignment[]
    Qualifications StaffQualification[]
    Schedules StaffSchedule[]
    TimeOff StaffTimeOff[]
    HoldSegments BookingHoldSegment[]
    BookingSegments BookingSegment[]
    createdAt  DateTime             @default(now())
    updatedAt  DateTime             @updatedAt

    @@unique([businessId, userId])
    @@index([userId, active])
}

model BusinessInvitation {
    id              String       @id @default(cuid())
    businessId      String
    normalizedEmail String
    invitedName     String
    role            BusinessRole
    tokenHash       String       @unique @db.Char(64)
    expiresAt       DateTime
    acceptedAt      DateTime?
    revokedAt       DateTime?
    inviterId       String
    activeKey       String?      @unique
    business        Business     @relation(fields: [businessId], references: [id], onDelete: Restrict)
    inviter         User         @relation("BusinessInvitationInviter", fields: [inviterId], references: [id], onDelete: Restrict)
    Locations       BusinessInvitationLocation[]
    Qualifications  BusinessInvitationQualification[]
    createdAt       DateTime     @default(now())
    updatedAt       DateTime     @updatedAt

    @@index([businessId, normalizedEmail, acceptedAt, revokedAt], map: "BusinessInvitation_business_email_state_idx")
    @@index([businessId, expiresAt, acceptedAt, revokedAt], map: "BusinessInvitation_business_expiry_state_idx")
    @@index([inviterId, createdAt])
}

model BusinessInvitationLocation {
    invitationId String
    locationId   String
    invitation   BusinessInvitation @relation(fields: [invitationId], references: [id], onDelete: Restrict)
    location     Location           @relation(fields: [locationId], references: [id], onDelete: Restrict)
    createdAt    DateTime           @default(now())

    @@id([invitationId, locationId])
    @@index([locationId])
}

model BusinessInvitationQualification {
    invitationId String
    offeringId   String
    locationId   String
    invitation   BusinessInvitation @relation(fields: [invitationId], references: [id], onDelete: Restrict)
    offering     ServiceOffering    @relation(fields: [offeringId], references: [id], onDelete: Restrict)
    location     Location           @relation(fields: [locationId], references: [id], onDelete: Restrict)
    createdAt    DateTime           @default(now())

    @@id([invitationId, offeringId, locationId])
    @@index([offeringId, locationId])
    @@index([locationId])
}

model LocationAssignment {
    membershipId String
    locationId   String
    membership   BusinessMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
    location     Location           @relation(fields: [locationId], references: [id], onDelete: Cascade)
    createdAt    DateTime           @default(now())

    @@id([membershipId, locationId])
    @@index([locationId])
}

model BusinessApplication {
    id             String            @id @default(cuid())
    businessId     String
    applicantId    String
    status         ApplicationStatus @default(DRAFT)
    ownerName      String
    email          String
    phone          String
    address        String
    industry       String
    serviceSummary String            @db.Text
    decisionNote   String?           @db.Text
    submittedAt    DateTime?
    reviewedAt     DateTime?
    reviewerId     String?
    business       Business          @relation(fields: [businessId], references: [id])
    applicant      User              @relation("BusinessApplicant", fields: [applicantId], references: [id])
    reviewer       User?             @relation("BusinessReviewer", fields: [reviewerId], references: [id])
    createdAt      DateTime          @default(now())
    updatedAt      DateTime          @updatedAt

    @@index([status, submittedAt])
    @@index([applicantId])
}

model BusinessSetup {
    businessId           String   @id
    profileComplete      Boolean  @default(false)
    firstLocationComplete Boolean @default(false)
    policiesAccepted     Boolean  @default(false)
    publicationReady     Boolean  @default(false)
    business             Business @relation(fields: [businessId], references: [id])
    createdAt            DateTime @default(now())
    updatedAt            DateTime @updatedAt
}

model ServiceOffering {
    id                  String           @id @default(cuid())
    businessId          String
    business            Business         @relation(fields: [businessId], references: [id])
    legacySubserviceId  String?          @unique
    category            String
    name                String
    description         String?          @db.Text
    durationMinutes     Int
    preparationMinutes  Int              @default(0)
    cleanupMinutes      Int              @default(0)
    priceCents          Int
    currency            String           @default("XCD")
    capacity            Int              @default(1)
    confirmationMode    ConfirmationMode @default(AUTOMATIC)
    allowFullPayment    Boolean          @default(true)
    allowDeposit        Boolean          @default(false)
    allowCash           Boolean          @default(true)
    depositKind         DepositKind?
    depositValue        Int?
    cancellationLeadMin Int              @default(0)
    active              Boolean          @default(true)
    Locations           ServiceLocation[]
    Qualifications      StaffQualification[]
    HoldSegments        BookingHoldSegment[]
    BookingSegments     BookingSegment[]
    InvitationQualifications BusinessInvitationQualification[]
    createdAt           DateTime         @default(now())
    updatedAt           DateTime         @updatedAt

    @@index([businessId, active, category])
    @@index([businessId, name])
}

model ServiceLocation {
    offeringId String
    locationId String
    active     Boolean         @default(true)
    offering   ServiceOffering @relation(fields: [offeringId], references: [id], onDelete: Cascade)
    location   Location        @relation(fields: [locationId], references: [id], onDelete: Cascade)
    createdAt  DateTime        @default(now())
    updatedAt  DateTime        @updatedAt

    @@id([offeringId, locationId])
    @@index([locationId, active])
}

model StaffQualification {
    membershipId String
    offeringId   String
    locationId   String
    membership   BusinessMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
    offering     ServiceOffering @relation(fields: [offeringId], references: [id], onDelete: Cascade)
    location     Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
    active       Boolean @default(true)
    createdAt    DateTime @default(now())

    @@id([membershipId, offeringId, locationId])
    @@index([offeringId, locationId, active])
}

model LocationHours {
    id        String   @id @default(cuid())
    locationId String
    location  Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
    weekday   Int
    startMinute Int
    endMinute Int
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@unique([locationId, weekday, startMinute, endMinute])
    @@index([locationId, weekday])
}

model StaffSchedule {
    id           String @id @default(cuid())
    membershipId String
    locationId   String
    membership   BusinessMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
    location     Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
    weekday      Int
    startMinute  Int
    endMinute    Int
    createdAt    DateTime @default(now())
    updatedAt    DateTime @updatedAt

    @@unique([membershipId, locationId, weekday, startMinute, endMinute])
    @@index([locationId, weekday])
}

model StaffTimeOff {
    id           String @id @default(cuid())
    membershipId String
    locationId   String
    membership   BusinessMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
    location     Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
    startsAt     DateTime
    endsAt       DateTime
    reason       String?
    createdAt    DateTime @default(now())
    updatedAt    DateTime @updatedAt

    @@index([membershipId, startsAt, endsAt])
    @@index([locationId, startsAt])
}

model SchedulingLock {
    id         String @id @default(cuid())
    lockKey    String @unique
    businessId String
    locationId String
    bucketAt   DateTime
    business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
    location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
    updatedAt  DateTime @updatedAt

    @@index([locationId, bucketAt])
}

model BookingHold {
    id             String @id @default(cuid())
    token          String @unique
    idempotencyKey String @unique
    businessId     String
    customerId     String?
    checkoutIdentity String
    expiresAt      DateTime
    consumedAt     DateTime?
    business       Business @relation(fields: [businessId], references: [id])
    customer       User? @relation(fields: [customerId], references: [id])
    Segments       BookingHoldSegment[]
    Order          BookingOrder?
    createdAt      DateTime @default(now())
    updatedAt      DateTime @updatedAt

    @@index([businessId, expiresAt, consumedAt])
    @@index([customerId, expiresAt])
}

model BookingHoldSegment {
    id             String @id @default(cuid())
    holdId         String
    offeringId     String
    locationId     String
    membershipId   String
    startsAt       DateTime
    endsAt         DateTime
    occupiedStartsAt DateTime
    occupiedEndsAt DateTime
    attendeeCount  Int @default(1)
    priceCents     Int
    hold           BookingHold @relation(fields: [holdId], references: [id], onDelete: Cascade)
    offering       ServiceOffering @relation(fields: [offeringId], references: [id])
    location       Location @relation(fields: [locationId], references: [id])
    membership     BusinessMembership @relation(fields: [membershipId], references: [id])

    @@index([membershipId, occupiedStartsAt, occupiedEndsAt])
    @@index([offeringId, locationId, startsAt])
}

model BookingOrder {
    id                  String @id @default(cuid())
    businessId          String
    customerId          String?
    legacyBookingId     String? @unique
    idempotencyKey      String @unique
    sourceHoldToken     String? @unique
    sourceHold          BookingHold? @relation(fields: [sourceHoldToken], references: [token], onDelete: Restrict)
    origin              BookingOrigin @default(CUSTOMER)
    status              BookingOrderStatus @default(DRAFT)
    customerName        String?
    customerEmail       String?
    customerPhone       String?
    currency            String @default("XCD")
    subtotalCents       Int
    paidCents           Int @default(0)
    paymentChoice       PaymentChoice
    dueOnlineCents      Int @default(0)
    dueAtAppointmentCents Int @default(0)
    business            Business @relation(fields: [businessId], references: [id])
    customer            User? @relation(fields: [customerId], references: [id])
    Segments            BookingSegment[]
    PaymentRequest      BookingPaymentRequest?
    createdAt           DateTime @default(now())
    updatedAt           DateTime @updatedAt

    @@index([businessId, status, createdAt])
    @@index([customerId, createdAt])
}

model BookingPaymentRequest {
    id                String @id @default(cuid())
    orderId           String @unique
    amountCents       Int
    currency          String @default("XCD")
    reference         String @unique
    provider          String?
    providerPaymentId String?
    status            PaymentRequestStatus @default(PENDING)
    order             BookingOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
    createdAt         DateTime @default(now())
    updatedAt         DateTime @updatedAt

    @@index([status, createdAt])
    @@index([provider, providerPaymentId])
}

model BookingSegment {
    id               String @id @default(cuid())
    orderId          String
    offeringId       String
    locationId       String
    membershipId     String?
    legacyBookingId  String? @unique
    startsAt         DateTime
    endsAt           DateTime
    occupiedStartsAt DateTime
    occupiedEndsAt   DateTime
    attendeeCount    Int @default(1)
    priceCents       Int
    confirmationMode ConfirmationMode
    status           BookingSegmentStatus
    order            BookingOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
    offering         ServiceOffering @relation(fields: [offeringId], references: [id])
    location         Location @relation(fields: [locationId], references: [id])
    membership       BusinessMembership? @relation(fields: [membershipId], references: [id])
    createdAt        DateTime @default(now())
    updatedAt        DateTime @updatedAt

    @@index([locationId, startsAt, status])
    @@index([membershipId, occupiedStartsAt, occupiedEndsAt])
    @@index([orderId, startsAt])
}

model BookingOverride {
    id             String @id @default(cuid())
    segmentId      String
    actorUserId    String
    reason         String @db.Text
    previousValues Json
    resultingValues Json
    createdAt      DateTime @default(now())

    @@index([segmentId, createdAt])
    @@index([actorUserId, createdAt])
}

model Spa {
    id                     String       @id @default(cuid())
    ownerId                String
    owner                  User         @relation(fields: [ownerId], references: [id])
    name                   String
    slug                   String       @unique
    description            String?
    logoUrl                String?
    coverUrl               String?
    timezone               String       @default("America/St_Lucia")
    colorPrimary           String       @default("#6EE7B7")
    address                String?
    phone                  String?
    email                  String?
    businessHours          Json
    depositRule            Json?
    paymentConfig          Json?
    requiresBookingConsent Boolean      @default(false)
    bookingConsentText     String?
    Services               Service[]
    Subservices            Subservice[]
    Employees              Employee[]
    Bookings               Booking[]
    Reviews                Review[]
    SupportTickets SupportTicket[]
    createdAt              DateTime     @default(now())
    updatedAt              DateTime     @updatedAt
}

model Service {
    id          String       @id @default(cuid())
    spaId       String
    spa         Spa          @relation(fields: [spaId], references: [id])
    name        String
    description String?
    active      Boolean      @default(true)
    Subservices Subservice[]
    createdAt   DateTime     @default(now())
    updatedAt   DateTime     @updatedAt
}

model Subservice {
    id           String        @id @default(cuid())
    spaId        String
    spa          Spa           @relation(fields: [spaId], references: [id])
    serviceId    String
    service      Service       @relation(fields: [serviceId], references: [id])
    name         String
    description  String?
    durationMin  Int
    priceCents   Int
    active       Boolean       @default(true)
    Providers    Employee[]    @relation("ProviderServices")
    Bookings     Booking[]
    BookingItems BookingItem[]
    createdAt    DateTime      @default(now())
    updatedAt    DateTime      @updatedAt
}

model Employee {
    id        String       @id @default(cuid())
    spaId     String
    spa       Spa          @relation(fields: [spaId], references: [id])
    userId    String?      @unique
    user      User?        @relation(fields: [userId], references: [id])
    name      String
    photoUrl  String?
    bio       String?
    services  Subservice[] @relation("ProviderServices")
    schedule  Json
    Bookings  Booking[]
    createdAt DateTime     @default(now())
    updatedAt DateTime     @updatedAt
    phone     String?
    email     String?
}

model Booking {
    id                String        @id @default(cuid())
    spaId             String
    spa               Spa           @relation(fields: [spaId], references: [id])
    userId            String?
    user              User?         @relation("UserBookings", fields: [userId], references: [id])
    employeeId        String?
    employee          Employee?     @relation(fields: [employeeId], references: [id])
    subserviceId      String
    subservice        Subservice    @relation(fields: [subserviceId], references: [id])
    customerName      String?
    customerEmail     String?
    customerPhone     String?
    start             DateTime
    end               DateTime
    status            BookingStatus @default(PENDING)
    notes             String?
    intakeForm        Json?
    consentAcceptedAt DateTime?
    consentSignature  String?
    paymentMethod     PaymentMethod
    paymentStatus     PaymentStatus @default(UNPAID)
    totalCents        Int
    discountCents     Int           @default(0)
    pointsRedeemed    Int           @default(0)
    paidCents         Int           @default(0)
    stripePiId        String?
    createdByRole     Role          @default(USER)
    cancellation      Cancellation?
    BookingItems      BookingItem[]
    createdAt         DateTime      @default(now())
    updatedAt         DateTime      @updatedAt

    @@index([spaId, start])
    @@index([employeeId, start])
}

model BookingItem {
    id           String     @id @default(cuid())
    bookingId    String
    booking      Booking    @relation(fields: [bookingId], references: [id], onDelete: Cascade)
    subserviceId String
    subservice   Subservice @relation(fields: [subserviceId], references: [id])
    orderIndex   Int
    createdAt    DateTime   @default(now())

    @@index([bookingId, orderIndex])
    @@index([subserviceId])
}

model Cancellation {
    id        String   @id @default(cuid())
    bookingId String   @unique
    booking   Booking  @relation(fields: [bookingId], references: [id])
    reason    String?
    feeCents  Int      @default(0)
    createdAt DateTime @default(now())
}

model Review {
    id           String   @id @default(cuid())
    spaId        String
    spa          Spa      @relation(fields: [spaId], references: [id])
    userId       String
    user         User     @relation(fields: [userId], references: [id])
    bookingId    String?
    rating       Int      @default(5)
    title        String
    comment      String
    verified     Boolean  @default(true)
    createdAt    DateTime @default(now())
    updatedAt    DateTime @updatedAt

    @@index([spaId])
    @@index([userId])
}

enum NotificationType {
    BOOKING_CONFIRMED
    BOOKING_CANCELLED
    BOOKING_REMINDER
    PAYMENT_RECEIVED
    REVIEW_RECEIVED
    SUPPORT_RESPONSE
}

model Notification {
    id        String           @id @default(cuid())
    userId    String
    user      User             @relation(fields: [userId], references: [id])
    type      NotificationType
    title     String
    message   String
    read      Boolean          @default(false)
    data      Json?
    createdAt DateTime         @default(now())
    updatedAt DateTime         @updatedAt

    @@index([userId, read])
}

enum SupportStatus {
    OPEN
    IN_PROGRESS
    RESOLVED
    CLOSED
}

model SupportTicket {
    id        String        @id @default(cuid())
    userId    String
    user      User          @relation(fields: [userId], references: [id])
    spaId     String?
    spa       Spa?          @relation(fields: [spaId], references: [id])
    subject   String
    message   String
    status    SupportStatus @default(OPEN)
    priority  String        @default("MEDIUM")
    replies   String?
    createdAt DateTime      @default(now())
    updatedAt DateTime      @updatedAt

    @@index([userId, status])
    @@index([spaId, status])
}

// Lightweight audit log for manager/owner actions
model AuditLog {
    id        String   @id @default(cuid())
    spaId     String?
    bookingId String?
    userId    String?  // the subject user (e.g., booking.userId)
    actorId   String?  // the user who performed the action
    actorRole Role     @default(OWNER)
    action    String
    details   Json?
    createdAt DateTime @default(now())

    @@index([spaId])
    @@index([bookingId])
    @@index([actorId])
}
